# The public production origin. This exact URL is used in canonical tags,
# Open Graph metadata, structured data, sitemap.xml and robots.txt. This
# must be the real custom domain, not the *.netlify.app one Netlify assigns
# by default — and it must also be set in the Netlify dashboard's own
# environment variables (Site settings → Environment variables), since this
# file is never read in production. A wrong or missing value there is what
# makes canonical tags point at the Netlify subdomain instead of this one.
NEXT_PUBLIC_SITE_URL=https://www.avonchambers.com

# Sanity content delivery
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=

# Contact form delivery via Resend. CONTACT_FROM_EMAIL must be a sender
# address verified in Resend. CONTACT_TO_EMAIL defaults to the site's email.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Avon Chambers <contact@example.com>"
CONTACT_TO_EMAIL=avonchambers.client@gmail.com


NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local-only test keys (do not deploy) are documented in README.md.
